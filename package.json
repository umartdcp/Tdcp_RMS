{
  "name": "tdcp-rms",
  "private": true,
  "version": "1.0.4",
  "main": "desktop/main.mjs",
  "author": "Tourism Development Corporation of Punjab",
  "description": "TDCP Restaurant Management System",
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client",
    "pack:cpanel": "node scripts/prepare-cpanel.mjs",
    "prestart": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "pk.gov.tdcp.rms",
    "productName": "TDCP RMS",
    "copyright": "Tourism Development Corporation of Punjab",
    "asar": false,
    "directories": { "output": "release" },
    "files": [
      "desktop/main.mjs",
      "desktop/preload.cjs",
      "server/app.js",
      "server/package.json",
      "server/.env",
      "server/.env.example",
      "server/src/**/*",
      "server/node_modules/**/*",
      "server/schema.sql",
      "client/dist/**/*",
      "client/public/tdcp-logo.png",
      "package.json",
      "!node_modules/**",
      "!client/node_modules/**",
      "!**/*.map",
      "!**/README.md"
    ],
    "win": {
      "icon": "client/public/tdcp-logo.png",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TDCP RMS"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
