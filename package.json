{
  "name": "tdcp-rms",
  "private": true,
  "version": "1.0.1",
  "main": "desktop/main.mjs",
  "author": "Tourism Development Corporation of Punjab",
  "description": "TDCP Restaurant Management System",
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client",
    "pack:cpanel": "node scripts/prepare-cpanel.mjs",
    "prestart": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  }
}
