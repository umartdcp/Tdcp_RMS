PORT=5000
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME
# Set true only when the MySQL host requires SSL
DATABASE_SSL=false
# Optional: comma-separated public URLs if the API is on another domain
ALLOWED_ORIGINS=
# Optional: override first-run seed password (default admin123)
SEED_ADMIN_PASSWORD=admin123
# Set to 1 only if this server should allow TDCP accounts and hide every other organization.
TDCP_ONLY=0
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
SYNC_URL=
SYNC_SECRET=
